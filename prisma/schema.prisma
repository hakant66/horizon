generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUSTAINABILITY_MANAGER
  DATA_CONTRIBUTOR
  FINANCE_REVIEWER
  AUDITOR
  HORIZON_CONSULTANT
}

enum ConsolidationMethod {
  OPERATIONAL_CONTROL
  FINANCIAL_CONTROL
  EQUITY_SHARE
}

enum RiskOrOpportunity {
  RISK
  OPPORTUNITY
}

enum Scope2Method {
  LOCATION_BASED
  MARKET_BASED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  OVERDUE
  CANCELLED
}

enum ApprovalStage {
  DATA_ENTRY
  MANAGER_REVIEW
  HORIZON_REVIEW
  APPROVED
  REVISION_REQUESTED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_OVERDUE
  REVISION_REQUESTED
  METRIC_APPROVED
  ANSWER_APPROVED
  REPORT_READY_FOR_REVIEW
  CERTIFICATION_DECISION
}

enum ReportingPeriodStatus {
  OPEN
  LOCKED
  SUBMITTED
  CERTIFIED
}

enum MetricEntryStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  VALIDATED
  NEEDS_CORRECTION
  READY_FOR_EXTERNAL_ASSURANCE
}

enum EvidenceStatus {
  UPLOADED
  ACCEPTED
  REJECTED
  NEEDS_CLARIFICATION
}

enum EmissionScope {
  SCOPE_1
  SCOPE_2
  SCOPE_3
}

enum ClimateRiskType {
  PHYSICAL_ACUTE
  PHYSICAL_CHRONIC
  TRANSITION_POLICY_LEGAL
  TRANSITION_MARKET
  TRANSITION_TECHNOLOGY
  TRANSITION_REPUTATION
}

enum TargetStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum ReportFramework {
  IFRS_S1
  IFRS_S2
  TSRS_1
  TSRS_2
}

enum ReportStatus {
  DRAFT
  GENERATED
  UNDER_REVIEW
  APPROVED
  SUBMITTED_FOR_CERTIFICATION
}

enum CertificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
}

enum LinkedEntityType {
  METRIC_ENTRY
  EMISSION_CALCULATION
  CLIMATE_RISK
  REPORT
  CERTIFICATION_SUBMISSION
  QUESTIONNAIRE_ANSWER
}

enum QuestionnaireType {
  VERBAL
  NUMERIC
}

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  taxId                  String?
  sector                 String
  naceCode               String?
  naceDescription        String?
  sasbSector             String?
  csrdSector             String?
  reportingFrameworks    String[]
  employeeCount          Int?
  annualTurnoverEurM     Decimal? @db.Decimal(12, 2)
  totalAssetsEurM        Decimal? @db.Decimal(12, 2)
  isPublicInterestEntity Boolean?
  headquartersCountry    String
  reportingCurrency      String
  consolidationMethod    ConsolidationMethod?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users                    User[]
  subsidiaries             Subsidiary[]
  businessUnits            BusinessUnit[]
  tasks                    Task[]
  notifications            Notification[]
  facilities               Facility[]
  reportingPeriods         ReportingPeriod[]
  metricEntries            MetricEntry[]
  evidence                 Evidence[]
  emissionCalculations     EmissionCalculation[]
  materialityTopics        MaterialityTopic[]
  climateRisks             ClimateRisk[]
  targets                  Target[]
  reports                  Report[]
  certifications           CertificationSubmission[]
  questionnaireTopics      QuestionnaireTopic[]
  questionnaires           Questionnaire[]
  questionnaireSections    QuestionnaireSection[]
  questionnaireSubsections QuestionnaireSubsection[]
  questionnaireQuestions   QuestionnaireQuestion[]
  questionnaireAnswers     QuestionnaireAnswer[]
  auditLogs                AuditLog[]
  esgSummary               EsgSummary?
  knowledgeBaseDocuments   KnowledgeBaseDocument[]
  knowledgeBaseChunks      KnowledgeBaseChunk[]
  aiSettings               AiSettings?
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           UserRole
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownedMetricEntries         MetricEntry[]             @relation("MetricEntryOwner")
  uploadedEvidence           Evidence[]                @relation("EvidenceUploader")
  ownedRisks                 ClimateRisk[]             @relation("RiskOwner")
  submittedCertifications    CertificationSubmission[] @relation("CertificationSubmitter")
  reviewedCertifications     CertificationSubmission[] @relation("CertificationReviewer")
  certificationComments      CertificationComment[]
  questionnaireAnswers       QuestionnaireAnswer[]     @relation("QuestionnaireAnsweringUser")
  questionnaireAnswerUpdates QuestionnaireAnswer[]     @relation("QuestionnaireUpdatedBy")
  questionnaireAnswerDeletes QuestionnaireAnswer[]     @relation("QuestionnaireDeletedBy")
  assignedTasks              Task[]                    @relation("TaskAssignedTo")
  createdTasks               Task[]                    @relation("TaskAssignedBy")
  approvedReports            Report[]                  @relation("ReportApprover")
  lockedPeriods              ReportingPeriod[]         @relation("PeriodLocker")
  reviewedEvidence           Evidence[]                @relation("EvidenceReviewer")
  notifications              Notification[]
  auditLogs                  AuditLog[]
  uploadedKbDocuments        KnowledgeBaseDocument[]
}

model Facility {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  country        String
  city           String?
  facilityType   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metricEntries        MetricEntry[]
  emissionCalculations EmissionCalculation[]
  climateRisks         ClimateRisk[]
}

model ReportingPeriod {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         ReportingPeriodStatus
  lockedById     String?
  lockedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lockedBy             User?                     @relation("PeriodLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  metricEntries        MetricEntry[]
  emissionCalculations EmissionCalculation[]
  materialityTopics    MaterialityTopic[]
  climateRisks         ClimateRisk[]
  targets              Target[]
  reports              Report[]
  certifications       CertificationSubmission[]
  questionnaireAnswers QuestionnaireAnswer[]
  tasks                Task[]

  @@unique([organizationId, name])
}

model MetricDefinition {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  category    String
  unit        String
  description String?
  isRequired  Boolean @default(true)
  sector      String?

  metricEntries MetricEntry[]
  targets       Target[]
}

model MetricEntry {
  id                 String            @id @default(cuid())
  organizationId     String
  facilityId         String
  reportingPeriodId  String
  metricDefinitionId String
  businessUnitId     String?
  value              Decimal?          @db.Decimal(14, 4)
  unit               String
  status             MetricEntryStatus @default(NOT_STARTED)
  approvalStage      ApprovalStage     @default(DATA_ENTRY)
  ownerUserId        String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility         Facility              @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  businessUnit     BusinessUnit?         @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  reportingPeriod  ReportingPeriod       @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  metricDefinition MetricDefinition      @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  ownerUser        User?                 @relation("MetricEntryOwner", fields: [ownerUserId], references: [id])
  emissions        EmissionCalculation[]

  @@unique([facilityId, reportingPeriodId, metricDefinitionId])
  @@index([organizationId, reportingPeriodId])
}

model Evidence {
  id               String           @id @default(cuid())
  organizationId   String
  linkedEntityType LinkedEntityType
  linkedEntityId   String
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  uploadedById     String
  reviewedById     String?
  reviewedAt       DateTime?
  status           EvidenceStatus   @default(UPLOADED)
  reviewerComment  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("EvidenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model EmissionFactor {
  id           String        @id @default(cuid())
  name         String
  country      String
  activityUnit String
  factorValue  Decimal       @db.Decimal(12, 6)
  factorUnit   String
  source       String
  versionYear  Int
  scope        EmissionScope
  scope2Method Scope2Method?
  category     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  calculations EmissionCalculation[]
}

model EmissionCalculation {
  id                 String        @id @default(cuid())
  organizationId     String
  facilityId         String
  reportingPeriodId  String
  metricEntryId      String
  emissionFactorId   String
  scope              EmissionScope
  scope2Method       Scope2Method?
  scope3Category     String?
  activityValue      Decimal       @db.Decimal(14, 4)
  activityUnit       String
  factorValue        Decimal       @db.Decimal(12, 6)
  resultTCO2e        Decimal       @db.Decimal(14, 6)
  calculationFormula String
  overrideReason     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility        Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  metricEntry     MetricEntry     @relation(fields: [metricEntryId], references: [id], onDelete: Cascade)
  emissionFactor  EmissionFactor  @relation(fields: [emissionFactorId], references: [id], onDelete: Restrict)
}

model MaterialityTopic {
  id                      String   @id @default(cuid())
  organizationId          String
  reportingPeriodId       String
  name                    String
  category                String
  financialImpactScore    Int
  impactSeverityScore     Int
  likelihoodScore         Int
  stakeholderConcernScore Int
  isMaterial              Boolean  @default(false)
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reportingPeriodId, name])
}

model ClimateRisk {
  id                      String             @id @default(cuid())
  organizationId          String
  reportingPeriodId       String
  facilityId              String?
  entryType               RiskOrOpportunity  @default(RISK)
  name                    String
  type                    ClimateRiskType
  probability             String
  impact                  String
  probabilityScore        Int?
  impactScore             Int?
  riskScore               Int?
  timeHorizon             String?
  status                  String          @default("Open")
  residualRisk            String?
  regulatoryRef           String?
  financialImpactEstimate Decimal?        @db.Decimal(14, 2)
  ownerUserId             String?
  mitigationPlan          String?
  notes                   String?
  aiNarrative             String?
  aiNarrativeAt           DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod    @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  facility        Facility?          @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  ownerUser       User?              @relation("RiskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  scenarios       ScenarioAnalysis[]
}

model ScenarioAnalysis {
  id                            String   @id @default(cuid())
  climateRiskId                 String
  scenarioName                  String
  temperaturePathway            String
  scenarioFramework             String?
  physicalHazard                String?
  qualitativeImpact             String?
  estimatedRevenueImpactPercent Decimal? @db.Decimal(8, 2)
  estimatedCostImpact           Decimal? @db.Decimal(14, 2)
  assumptions                   String?
  adaptationMeasure             String?
  confidenceLevel               String?
  aiImpactSummary               String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  climateRisk ClimateRisk @relation(fields: [climateRiskId], references: [id], onDelete: Cascade)
}

model Target {
  id                 String       @id @default(cuid())
  organizationId     String
  reportingPeriodId  String
  name               String
  metricDefinitionId String
  baselineYear       Int
  baselineValue      Decimal      @db.Decimal(14, 4)
  targetYear         Int
  targetValue        Decimal      @db.Decimal(14, 4)
  currentValue       Decimal      @db.Decimal(14, 4)
  status             TargetStatus
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod  ReportingPeriod  @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
}

model Report {
  id                 String          @id @default(cuid())
  organizationId     String
  reportingPeriodId  String
  framework          ReportFramework
  status             ReportStatus    @default(DRAFT)
  governanceText     String?
  strategyText       String?
  riskManagementText String?
  metricsTargetsText String?
  generatedAt        DateTime?
  submittedAt        DateTime?
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod           @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  approvedBy      User?                     @relation("ReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  certifications  CertificationSubmission[]

  @@index([organizationId, status])
}

model CertificationSubmission {
  id                String              @id @default(cuid())
  organizationId    String
  reportingPeriodId String
  reportId          String
  status            CertificationStatus @default(DRAFT)
  submittedById     String?
  reviewedById      String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  decisionNotes     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod        @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  report          Report                 @relation(fields: [reportId], references: [id], onDelete: Cascade)
  submittedBy     User?                  @relation("CertificationSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy      User?                  @relation("CertificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  comments        CertificationComment[]
}

model CertificationComment {
  id                        String            @id @default(cuid())
  certificationSubmissionId String
  authorUserId              String
  comment                   String
  linkedEntityType          LinkedEntityType?
  linkedEntityId            String?
  createdAt                 DateTime          @default(now())

  certificationSubmission CertificationSubmission @relation(fields: [certificationSubmissionId], references: [id], onDelete: Cascade)
  authorUser              User                    @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
}

model QuestionnaireTopic {
  id             String   @id @default(cuid())
  organizationId String
  name_tr        String
  name_en        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questions    QuestionnaireQuestion[]

  @@unique([organizationId, name_tr])
}

model Questionnaire {
  id             String            @id @default(cuid())
  organizationId String
  name_tr        String
  name_en        String?
  type           QuestionnaireType
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections     QuestionnaireSection[]
  questions    QuestionnaireQuestion[]
  answers      QuestionnaireAnswer[]

  @@unique([organizationId, name_tr])
}

model QuestionnaireSection {
  id              String   @id @default(cuid())
  organizationId  String
  questionnaireId String
  name            String
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire             @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  subsections   QuestionnaireSubsection[]
  questions     QuestionnaireQuestion[]

  @@unique([questionnaireId, name])
}

model QuestionnaireSubsection {
  id                     String   @id @default(cuid())
  organizationId         String
  questionnaireSectionId String
  name                   String
  orderIndex             Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questionnaireSection QuestionnaireSection    @relation(fields: [questionnaireSectionId], references: [id], onDelete: Cascade)
  questions            QuestionnaireQuestion[]

  @@unique([questionnaireSectionId, name])
}

model QuestionnaireQuestion {
  id                        String   @id @default(cuid())
  organizationId            String
  questionnaireId           String
  questionnaireSectionId    String?
  questionnaireSubsectionId String?
  questionnaireTopicId      String?
  section                   String
  code                      String?
  title                     String
  question_text             String
  unit                      String?
  owner_name                String?
  owner_department          String?
  owner_email               String?
  helper                    String?
  example                   String?
  reminder                  String?
  video_link                String?
  sourceSheet               String?
  sourceRowNumber           Int?
  version                   Int      @default(1)
  isActive                  Boolean  @default(true)
  supersededById            String?
  standardCode              String?
  evidenceType              String?
  isMandatory               Boolean  @default(false)
  acceptanceCriteria        String?
  errorWarning              String?
  minValue                  Decimal? @db.Decimal(14, 4)
  maxValue                  Decimal? @db.Decimal(14, 4)
  created_datetime          DateTime @default(now())
  updated_datetime          DateTime @updatedAt

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questionnaire           Questionnaire            @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  questionnaireSection    QuestionnaireSection?    @relation(fields: [questionnaireSectionId], references: [id], onDelete: SetNull)
  questionnaireSubsection QuestionnaireSubsection? @relation(fields: [questionnaireSubsectionId], references: [id], onDelete: SetNull)
  questionnaireTopic      QuestionnaireTopic?      @relation(fields: [questionnaireTopicId], references: [id], onDelete: SetNull)
  answers                 QuestionnaireAnswer[]
}

model QuestionnaireAnswer {
  id                      String    @id @default(cuid())
  organizationId          String
  questionnaireId         String
  questionnaireQuestionId String
  reportingPeriodId       String
  answer_text             String?
  answer_number           Decimal?  @db.Decimal(18, 4)
  answering_user_id       String
  answering_timestamp     DateTime  @default(now())
  updated_by_id           String?
  updated_timestamp       DateTime?
  deleted_by_id           String?
  deleted_timestamp       DateTime?
  approvalStage           ApprovalStage @default(DATA_ENTRY)
  createdAt               DateTime  @default(now())

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questionnaire         Questionnaire         @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  questionnaireQuestion QuestionnaireQuestion @relation(fields: [questionnaireQuestionId], references: [id], onDelete: Cascade)
  reportingPeriod       ReportingPeriod       @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  answeringUser         User                  @relation("QuestionnaireAnsweringUser", fields: [answering_user_id], references: [id], onDelete: Restrict)
  updatedBy             User?                 @relation("QuestionnaireUpdatedBy", fields: [updated_by_id], references: [id], onDelete: SetNull)
  deletedBy             User?                 @relation("QuestionnaireDeletedBy", fields: [deleted_by_id], references: [id], onDelete: SetNull)

  @@unique([questionnaireQuestionId, reportingPeriodId])
  @@index([organizationId, questionnaireId])
}

model EsgSummary {
  id             String   @id @default(cuid())
  organizationId String   @unique
  // 1. Kurumsal Kimlik ve Operasyonel Yapı
  legalName                   String?
  brandPortfolio               String?
  naceCode                     String?
  sectorDescription            String?
  operatingCountries           String?
  totalEmployees               Int?
  employeeBlueCollar           Int?
  employeeWhiteCollar          Int?
  employeeMale                 Int?
  employeeFemale               Int?
  employeePermanent            Int?
  employeeTemporary            Int?
  // 2. Finansal Temeller
  fiscalYearStart              DateTime?
  fiscalYearEnd                DateTime?
  annualRevenue                Decimal?  @db.Decimal(20, 2)
  ebitda                       Decimal?  @db.Decimal(20, 2)
  netProfit                    Decimal?  @db.Decimal(20, 2)
  totalAssets                  Decimal?  @db.Decimal(20, 2)
  totalEquity                  Decimal?  @db.Decimal(20, 2)
  sustainabilityCapexForecast  Decimal?  @db.Decimal(20, 2)
  // 3. Yönetişim ve Stratejik Yaklaşım
  sustainabilityGovernanceBody  String?
  businessResilienceAssessment  String?
  antiBriberyPolicyUpdated      Boolean?
  gdprKvkkPolicyUpdated         Boolean?
  // 4. Çevresel ve İklimsel Veriler
  annualElectricityConsumption  Decimal?  @db.Decimal(14, 4)
  annualNaturalGasConsumption   Decimal?  @db.Decimal(14, 4)
  annualFuelConsumption         Decimal?  @db.Decimal(14, 4)
  renewableEnergyPercent        Decimal?  @db.Decimal(5, 2)
  scope1Emissions               Decimal?  @db.Decimal(14, 4)
  scope2Emissions               Decimal?  @db.Decimal(14, 4)
  scope3Emissions               Decimal?  @db.Decimal(14, 4)
  annualWaterWithdrawal         Decimal?  @db.Decimal(14, 4)
  wasteRecyclingRate            Decimal?  @db.Decimal(5, 2)
  // 5. Sosyal ve Beşeri Sermaye
  lostTimeInjuryRate            Decimal?  @db.Decimal(8, 4)
  avgTrainingHoursPerEmployee   Decimal?  @db.Decimal(8, 2)
  femaleManagerPercent          Decimal?  @db.Decimal(5, 2)
  supplierSocialAuditConducted  Boolean?
  employeeTurnoverRate          Decimal?  @db.Decimal(5, 2)
  climateRiskInRiskRegister     Boolean?
  rdExpenditure                 Decimal?  @db.Decimal(20, 2)
  reportBoundaryNote            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String?
  entityType     String?
  entityId       String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId, createdAt])
}

model Subsidiary {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  country          String
  ownershipPercent Decimal  @db.Decimal(5, 2)
  isInScope        Boolean  @default(true)
  consolidationNote String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BusinessUnit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent        BusinessUnit?  @relation("BUHierarchy", fields: [parentId], references: [id])
  children      BusinessUnit[] @relation("BUHierarchy")
  metricEntries MetricEntry[]

  @@unique([organizationId, name])
}

model SectorDefinition {
  id       String  @id @default(cuid())
  code     String  @unique
  name_tr  String
  name_en  String
  parentId String?
  isActive Boolean @default(true)
  metricCodes String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   SectorDefinition?  @relation("SectorTree", fields: [parentId], references: [id])
  children SectorDefinition[] @relation("SectorTree")
}

model Task {
  id                String       @id @default(cuid())
  organizationId    String
  reportingPeriodId String?
  assignedToId      String
  assignedById      String
  title             String
  description       String?
  entityType        String?
  entityId          String?
  dueDate           DateTime?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(OPEN)
  completedAt       DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id], onDelete: SetNull)
  assignedTo      User             @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy      User             @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([assignedToId, status])
}

model AuditLog {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String?
  action          String
  entityType      String
  entityId        String
  beforeValueJson Json?
  afterValueJson  Json?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model KnowledgeBaseDocument {
  id             String   @id @default(cuid())
  organizationId String
  uploadedById   String
  fileName       String
  fileType       String
  fileSize       Int
  storedPath     String
  encryptionIv   String
  authTag        String
  description    String?
  uploadedAt     DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User                  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  chunks       KnowledgeBaseChunk[]

  @@index([organizationId, uploadedAt])
}

model KnowledgeBaseChunk {
  id             String                       @id @default(cuid())
  organizationId String
  documentId     String
  content        String
  chunkIndex     Int
  tokenCount     Int                          @default(0)
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     KnowledgeBaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
}

model AiSettings {
  id               String    @id @default(cuid())
  organizationId   String    @unique
  llmProvider      String    @default("openai")
  llmModel         String    @default("gpt-4o-mini")
  openaiApiKey     String?
  anthropicApiKey  String?
  googleApiKey     String?
  indexedAt        DateTime?
  indexedChunks    Int       @default(0)
  indexedDocs      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
